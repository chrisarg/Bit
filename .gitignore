# Build directories
/build/
/deps/

# Compiled object files
*.o
*.obj

# Compiled libraries
*.so
*.a
*.dll
*.dylib

# Compiled executables
/test_bit

# Bug reports
/bug_reports

# Per-configuration CPU tuning artifacts. Compact architecture-labelled
# summaries in tuning-results/ are intentionally tracked.
/tuning-results/.work/

# Editor and OS specific files
.vscode/
.idea/
.DS_Store
*~
*.swp
*.swo


# ignore CSV, but not if it's in the benchmark directory (for output)
*.csv
!benchmark_GPU_params/**/*.csv
# CPU sweep results: tracked so multiple machines can push results to the
# shared benchmark_CPU_params/ directory for cross-CPU aggregation/plotting.
!benchmark_CPU_params/**/*.csv
# FAISS comparison sweep results (benchmark_FAISS/) are tracked: CSVs, and the
# report PDF/PNGs/logs, are synchronized so README figures and cross-machine
# results persist in the repo.
!benchmark_FAISS/**/*.csv

# Custom build directories (when BUILD_DIR is specified)
