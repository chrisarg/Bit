{
  "_docs": "Configuration for scripts/sweep_cpu_tuning.pl. Environment variables override these values (env wins). See README.md 'Focused Kernel Profiling & Tuning'. seed drives the random config order for reproducibility.",
  "seed": 12345,
  "sweep": {
    "libpopcnt_modes": "0",
    "cpu_tiles": "4,8,16,32",
    "k_blocks": "256,512,768,1024",
    "shapes": "1x1,2x2,2x4,4x2",
    "unrolls": "1,2,4",
    "buffer_sizes": "128,512,1024,4096"
  },
  "run": {
    "cc": "clang",
    "cores": "auto",
    "bits": 65536,
    "left": 1000,
    "right": 1000,
    "threads": "auto",
    "reps": 5,
    "perf_reps": 3,
    "elevate": "auto",
    "priority": "nice",
    "max_configs": 0
  },
  "output": {
    "arch_tag": "",
    "run_label": "",
    "numa_policy": "default OS policy",
    "numa_cmd": ""
  }
}
